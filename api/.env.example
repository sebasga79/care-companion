# Care Companion API — variables de entorno (fase C1)
# Copiar a .env y ajustar si hace falta. Nunca commitear .env con valores
# reales — ver docs/policies/secrets.md.

APP_ENV=development
DATABASE_PATH=./data/care_companion.db
API_HOST=0.0.0.0
API_PORT=8000

# Allowlist: fake | groq | ollama (docs/auditoria-kit-oficial-2026-08-07.md
# §3 — decisión de modelo: Groq/Llama 3.1 70B primario, Ollama/Phi-3.5 Mini
# local de resguardo). base_url y model tienen default por proveedor si se
# dejan sin fijar; ver app/core/config.py.
LLM_PROVIDER=fake
LLM_BASE_URL=changeme
LLM_API_KEY=changeme
LLM_MODEL=fake-model-v1
LLM_REQUEST_TIMEOUT_SECONDS=20

# Resguardo opcional: si LLM_PROVIDER=groq falla/no responde en vivo, se
# reintenta contra este segundo proveedor (típicamente ollama local). Dejar
# LLM_FALLBACK_PROVIDER vacío desactiva el resguardo.
# LLM_FALLBACK_PROVIDER=ollama
# LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
# LLM_FALLBACK_MODEL=phi3.5

# Costo estimado por llamada (rúbrica §5). Sin fijar, /metrics reporta
# "pendiente" en vez de inventar un precio. Estos valores son ILUSTRATIVOS
# (formato USD por millón de tokens) — verificar el precio vigente en
# https://console.groq.com/docs/pricing (o el de producción equivalente si
# se usa Ollama local) antes de reportarlo en el informe final; no copiar
# este ejemplo sin confirmar.
# LLM_COST_PER_MILLION_INPUT_TOKENS=0.00
# LLM_COST_PER_MILLION_OUTPUT_TOKENS=0.00
